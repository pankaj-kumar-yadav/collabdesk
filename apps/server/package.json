{
  "name": "@collabdesk/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:load": "tsx scripts/load-test.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@collabdesk/shared": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "@fastify/websocket": "^11.0.2",
    "@prisma/client": "^6.5.0",
    "better-auth": "^1.2.5",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "lib0": "^0.2.99",
    "ws": "^8.18.1",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.24",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.0",
    "prisma": "^6.5.0",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
