# =============================================================================
# CollabDesk — production env (Neon + Render + Electron)
# Copy values into Render / Vercel dashboards. Do NOT commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) API service (Render Web Service — apps/server)
# -----------------------------------------------------------------------------

# Neon pooled connection string (Dashboard → Connection details → Pooled)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Public HTTPS URL of this API service (no trailing slash)
BETTER_AUTH_URL=https://collabdesk-api.onrender.com

# Render injects PORT; keep HOST as 0.0.0.0
PORT=4000
HOST=0.0.0.0

# Public HTTPS URL of the Next.js web service (must match the web deploy)
CORS_ORIGIN=https://collabdesk-web.onrender.com

# Required behind HTTPS
COOKIE_SECURE=true

YJS_SNAPSHOT_EVERY_UPDATES=50
YJS_SNAPSHOT_EVERY_MS=30000
PRESENCE_THROTTLE_MS=75

# -----------------------------------------------------------------------------
# 2) Web service (Render / Vercel — apps/web) — build-time vars
# -----------------------------------------------------------------------------

NEXT_PUBLIC_API_URL=https://collabdesk-api.onrender.com
NEXT_PUBLIC_WS_URL=wss://collabdesk-api.onrender.com/ws

# -----------------------------------------------------------------------------
# 3) Electron (local pack / release) — points shell at hosted UI
# -----------------------------------------------------------------------------

ELECTRON_START_URL=https://collabdesk-web.onrender.com
