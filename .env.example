# Local development — for Neon/Render see .env.production.example

# Database
DATABASE_URL=postgresql://collabdesk:collabdesk@localhost:5432/collabdesk

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:4000

# Server
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Web / Electron
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
ELECTRON_START_URL=http://localhost:3000

# Persistence
YJS_SNAPSHOT_EVERY_UPDATES=50
YJS_SNAPSHOT_EVERY_MS=30000
PRESENCE_THROTTLE_MS=75
